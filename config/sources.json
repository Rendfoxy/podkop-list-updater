{
  "outputs": [
    {
      "name": "podkop-russia-domains",
      "kind": "domain",
      "remote_sources": [
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Russia/inside-raw.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/discord.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/meta.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/twitter.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/youtube.lst"
      ],
      "local_sources": [
        "config/manual/podkop-russia-seed.txt",
        "config/manual/podkop-russia-domains.txt"
      ],
      "exclude_local_sources": [
        "config/manual/podkop-russia-exclude-domains.txt"
      ]
    },
    {
      "name": "podkop-russia-subnets",
      "kind": "subnet",
      "remote_sources": [],
      "local_sources": [
        "config/manual/podkop-russia-seed.txt",
        "config/manual/podkop-russia-subnets.txt"
      ]
    },
    {
      "name": "podkop-foreign-domains",
      "kind": "domain",
      "remote_sources": [
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Categories/hodca.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/cloudflare.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/cloudfront.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/digitalocean.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/hetzner.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/ovh.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/telegram.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/tiktok.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/meta.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/twitter.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/google_ai.lst",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/anthropic",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/aws",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/cloudflare",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/digitalocean",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/hetzner",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/meta",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/openai",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/telegram",
        "https://raw.githubusercontent.com/v2fly/domain-list-community/master/data/tiktok",
        "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/openai.yaml",
        "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/anthropic.yaml",
        "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/telegram.yaml",
        "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/tiktok.yaml"
      ],
      "local_sources": [
        "config/manual/podkop-foreign-seed.txt",
        "config/manual/podkop-foreign-domains.txt"
      ],
      "exclude_remote_sources": [
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/discord.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Services/youtube.lst"
      ],
      "exclude_local_sources": [
        "config/manual/podkop-foreign-exclude-domains.txt"
      ],
      "discovery": [
        {
          "provider": "urlscan",
          "roots_files": [
            "config/manual/podkop-foreign-roots.txt"
          ],
          "limit_per_root": 100,
          "timeout_per_root": 6
        },
        {
          "provider": "crtsh",
          "roots_files": [
            "config/manual/podkop-foreign-crtsh-roots.txt"
          ],
          "limit_per_root": 80,
          "timeout_per_root": 10
        }
      ]
    },
    {
      "name": "podkop-foreign-subnets",
      "kind": "subnet",
      "remote_sources": [
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/cloudfront.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/digitalocean.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/hetzner.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/meta.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/ovh.lst",
        "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/twitter.lst"
      ],
      "remote_source_groups": [
        {
          "name": "telegram-ipv4",
          "sources": [
            "https://core.telegram.org/resources/cidr.txt",
            "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/telegram.lst"
          ],
          "cache_path": "src/_upstream_cache/telegram-ipv4.lst"
        },
        {
          "name": "cloudflare-ipv4",
          "sources": [
            "https://api.cloudflare.com/client/v4/ips",
            "https://www.cloudflare.com/ips-v4",
            "https://raw.githubusercontent.com/itdoginfo/allow-domains/main/Subnets/IPv4/cloudflare.lst"
          ],
          "cache_path": "src/_upstream_cache/cloudflare-ipv4.lst"
        },
        {
          "name": "aws-ipv4",
          "sources": [
            "https://ip-ranges.amazonaws.com/ip-ranges.json"
          ],
          "cache_path": "src/_upstream_cache/aws-ipv4.lst"
        },
        {
          "name": "hetzner-asn",
          "sources": [
            "https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS24940&min_peers_seeing=10"
          ],
          "cache_path": "src/_upstream_cache/hetzner-asn.lst"
        },
        {
          "name": "ovh-asn",
          "sources": [
            "https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS16276&min_peers_seeing=10"
          ],
          "cache_path": "src/_upstream_cache/ovh-asn.lst"
        },
        {
          "name": "digitalocean-asn",
          "sources": [
            "https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS14061&min_peers_seeing=10"
          ],
          "cache_path": "src/_upstream_cache/digitalocean-asn.lst"
        },
        {
          "name": "meta-asn",
          "sources": [
            "https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS32934&min_peers_seeing=10"
          ],
          "cache_path": "src/_upstream_cache/meta-asn.lst"
        },
        {
          "name": "twitter-asn",
          "sources": [
            "https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS13414&min_peers_seeing=10"
          ],
          "cache_path": "src/_upstream_cache/twitter-asn.lst"
        }
      ],
      "local_sources": [
        "config/manual/podkop-foreign-seed.txt",
        "config/manual/podkop-foreign-subnets.txt"
      ],
      "exclude_local_sources": [
        "config/manual/podkop-foreign-exclude-subnets.txt"
      ],
      "resolve_from_outputs": [
        {
          "output": "podkop-foreign-domains",
          "roots_files": [
            "config/manual/podkop-foreign-resolve-roots.txt",
            "config/manual/podkop-foreign-crtsh-roots.txt"
          ],
          "exclude_roots_files": [
            "config/manual/podkop-foreign-resolve-exclude-roots.txt"
          ],
          "cache_path": "src/_upstream_cache/foreign-domain-resolved.lst",
          "limit": 800,
          "timeout_per_lookup": 2
        }
      ]
    }
  ]
}
